# 只在开发模式中被载入
ENV = 'development'

# 公共基础路径, 详见: https://cn.vitejs.dev/guide/build.html#public-base-path
VITE_BASE_URL = /

# Browser calls same-origin /api. Vite proxies that to the local Spring Boot server.
# The backend already serves /api/**, so the dev proxy must NOT strip the /api prefix.
VITE_BASE_API_URL = '/api'

# Local Spring Boot backend
VITE_API_PROXY_TARGET = http://localhost:8080

VITE_DROP_CONSOLE = false
